---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '주휴수당·주급 계산기',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
  url: `${SITE.url}/calc/holiday-pay/`,
};
---

<BaseLayout
  title="주휴수당 계산기 — 시급·주 근무시간으로 주휴수당·주급 계산 | 가온"
  description="시급과 1주 근무시간을 넣으면 주휴수당과 주휴수당을 포함한 주급·월 환산액을 계산합니다. 주 15시간 이상 개근 시 발생하는 주휴수당 기준으로 계산하며, 결과는 참고용입니다. 계산은 브라우저에서만 이루어집니다."
  canonical="/calc/holiday-pay/"
  jsonld={jsonld}
>
  <section class="section">
    <div class="wrap wrap-narrow">
      <p class="breadcrumb">
        <a href="/">홈</a> &rsaquo; <a href="/calc/">법률 계산기</a> &rsaquo; 주휴수당
      </p>
      <div class="section-head">
        <h2>주휴수당·주급 계산기</h2><span class="rule"></span><span class="count">CALC 08</span>
      </div>

      <div class="callout warn">
        <strong>주휴수당은 1주 소정근로시간이 15시간 이상이고 개근한 경우에 발생</strong>합니다.
        이 계산기는 그 기준으로 대략의 금액을 보여주는 <strong>참고용</strong>이며, 실제 지급액은 근로계약·수당 구성에 따라 달라질 수 있습니다.
      </div>

      <div class="panel">
        <div class="field-row-2">
          <div class="field-group">
            <label for="hp-wage">시급 (원)</label>
            <input type="number" id="hp-wage" min="0" step="10" placeholder="예: 10000" />
          </div>
          <div class="field-group">
            <label for="hp-hours">1주 근무시간 (시간)</label>
            <input type="number" id="hp-hours" min="0" max="68" step="0.5" placeholder="예: 40" />
          </div>
        </div>
        <div class="field-group">
          <label for="hp-min">올해 최저시급 (원, 선택)</label>
          <input type="number" id="hp-min" min="0" step="10" placeholder="입력하면 최저임금 미달 여부를 확인" />
          <p class="hint">최저시급은 매년 바뀝니다. 고용노동부 고시액을 입력하면 미달 여부를 함께 확인합니다.</p>
        </div>

        <div class="btn-row">
          <button type="button" class="btn" id="hp-run">주휴수당 계산</button>
          <button type="button" class="btn ghost" id="hp-reset">초기화</button>
        </div>

        <div id="hp-result" style="display:none;">
          <div class="result-box">
            <div class="result-line">
              <span class="k">주휴 발생 시간</span><span class="v" id="hpr-hours"></span>
            </div>
            <div class="result-line">
              <span class="k">주휴수당 (주)</span><span class="v" id="hpr-pay"></span>
            </div>
            <div class="result-line result-total">
              <span class="k">주급 (주휴수당 포함)</span><span class="v" id="hpr-week"></span>
            </div>
            <div class="result-line">
              <span class="k">월 환산 (참고)</span><span class="v" id="hpr-month"></span>
            </div>
          </div>
          <p class="hint" id="hpr-detail" style="margin-top:.8rem;"></p>
        </div>
      </div>

      <div class="source-panel">
        <h2>출처</h2>
        <ul>
          <li>
            <span class="src-issuer">국가법령정보센터</span>
            <span>근로기준법 제55조 (휴일), 제18조 (단시간근로자)</span>
          </li>
        </ul>
        <p class="src-note">
          주휴수당은 1주 소정근로시간 15시간 이상, 소정근로일 개근 시 발생합니다. 월 환산은 주급 &times; 4.345(주/월)로 계산한 참고치입니다.
        </p>
      </div>

      <div class="panel" style="margin-top:1.6rem;">
        <h2 class="with-rule">어떻게 계산하나</h2>
        <ol class="step-list" style="margin-top:1rem;">
          <li><b>주휴 시간</b> — 1주 소정근로시간 &divide; 40 &times; 8시간(최대 8시간). 주 40시간 이상이면 8시간분이 발생합니다.</li>
          <li><b>주휴수당</b> — 주휴 시간 &times; 시급.</li>
          <li><b>주급</b> — 실제 근무한 시간 임금 + 주휴수당. 월 환산은 주급 &times; 4.345입니다.</li>
        </ol>
        <div class="callout">
          주휴수당을 못 받았다면 임금체불입니다. <a href="/guides/minimum-wage-holiday-pay/">최저임금·주휴수당 가이드</a>와
          <a href="/guides/unpaid-wages/">임금체불 대응</a>을 참고하세요.
        </div>
      </div>

      <div class="library-banner" style="margin-top:2rem;">
        <div>
          <h3>주휴수당·임금을 못 받고 있다면</h3>
          <p>고용노동청 진정으로 국가가 대신 조사·압박해 줍니다.</p>
        </div>
        <a class="btn-stamp" href="/tools/labor-complaint/">임금체불 진정서 작성 &rsaquo;</a>
      </div>
    </div>
  </section>
  <div class="wrap">
    <div class="ad-slot" aria-hidden="true"><div class="ph">광고 영역 (AdSense) — 승인 후 자동 노출</div></div>
  </div>

  <script is:inline>
    (function () {
      'use strict';
      var $ = function (id) { return document.getElementById(id); };
      var won = function (n) { return Math.round(n).toLocaleString('ko-KR') + '원'; };

      $('hp-run').addEventListener('click', function () {
        var wage = Number($('hp-wage').value) || 0;
        var hours = Number($('hp-hours').value) || 0;
        var minWage = $('hp-min').value === '' ? null : Number($('hp-min').value);
        if (!wage) { $('hp-wage').focus(); return; }
        if (!hours) { $('hp-hours').focus(); return; }

        var weekly = Math.min(hours, 40);
        var holidayHours = hours >= 15 ? (weekly / 40) * 8 : 0;
        var holidayPay = holidayHours * wage;
        var weekPay = hours * wage + holidayPay;
        var monthly = weekPay * 4.345;

        $('hpr-hours').textContent = holidayHours ? (Math.round(holidayHours * 100) / 100) + '시간' : '없음';
        $('hpr-pay').textContent = holidayHours ? won(holidayPay) : '주 15시간 미만';
        $('hpr-week').textContent = won(weekPay);
        $('hpr-month').textContent = won(monthly);

        var detail;
        if (hours < 15) {
          detail = '1주 근무시간이 15시간 미만이라 주휴수당이 발생하지 않습니다. 위 주급은 근무시간 임금만 반영한 값입니다.';
        } else {
          detail = '주 ' + hours + '시간 개근 기준. 주휴수당은 소정근로일을 모두 개근한 경우에 발생합니다.';
        }
        if (minWage !== null && minWage > 0) {
          detail += wage < minWage
            ? ' ⚠ 입력한 시급(' + won(wage) + ')이 최저시급(' + won(minWage) + ')에 미달합니다 — 차액은 청구할 수 있습니다.'
            : ' 시급이 최저시급 이상입니다.';
        }
        $('hpr-detail').textContent = detail;

        $('hp-result').style.display = 'block';
        $('hp-result').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });

      $('hp-reset').addEventListener('click', function () {
        $('hp-wage').value = ''; $('hp-hours').value = ''; $('hp-min').value = '';
        $('hp-result').style.display = 'none';
      });
    })();
  </script>
</BaseLayout>
